# Variables de entorno del frontend SmartLot.
# Copiar a .env y completar. NUNCA commitear valores reales (.env está en .gitignore).

# URL del backend en producción. Debe ser HTTPS (src/api/client.js lo advierte).
# En desarrollo no se usa: Vite hace proxy de /api a http://localhost:3000.
VITE_API_URL=https://tu-api.example.com

# Clave pública de Mercado Pago (pantallas de pago y pagos-test).
VITE_MP_PUBLIC_KEY=

# URL pública del frontend, usada para armar enlaces en plantillas de email.
VITE_FRONTEND_URL=http://localhost:5173

# API key de Google Maps para los mapas de garages (restringir por dominio).
VITE_GOOGLE_MAPS_FRONTEND_KEY=
